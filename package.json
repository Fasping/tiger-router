{
    "name": "tiger-router",
    "version": "3.0.1",
    "description": "A tiny, typed and concurrent-safe router for React 18 and 19, with zero runtime dependencies.",
    "keywords": [
        "react",
        "router",
        "routing",
        "minimalistic",
        "tiny",
        "hooks",
        "typescript",
        "react-19",
        "spa",
        "client-side-routing"
    ],
    "homepage": "https://github.com/Fasping/tiger-router#readme",
    "bugs": "https://github.com/Fasping/tiger-router/issues",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Fasping/tiger-router.git"
    },
    "license": "ISC",
    "author": "Fernando Cases <nandocasesgarcia@gmail.com>",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "scripts": {
        "dev": "vite",
        "preview": "vite preview",
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:integration": "node scripts/integration-test.mjs",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "size": "size-limit",
        "check:package": "publint && attw --pack .",
        "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:package && npm run size && npm run test:integration",
        "prepublishOnly": "npm run verify"
    },
    "peerDependencies": {
        "react": "^18.2.0 || ^19.0.0"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@biomejs/biome": "^2.5.8",
        "@size-limit/preset-small-lib": "^11.2.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.5",
        "@vitest/coverage-v8": "^4.1.10",
        "happy-dom": "^20.11.2",
        "publint": "^0.3.23",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "size-limit": "^11.2.0",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vite": "^8.2.1",
        "vitest": "^4.1.10"
    },
    "size-limit": [
        {
            "name": "everything",
            "path": "dist/index.js",
            "limit": "3.5 kB",
            "ignore": [
                "react"
            ]
        },
        {
            "name": "typical app (Router, Routes, Route, Link, hooks)",
            "path": "dist/index.js",
            "import": "{ Router, Routes, Route, Link, useParams, useNavigate }",
            "limit": "3 kB",
            "ignore": [
                "react"
            ]
        }
    ],
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    }
}
